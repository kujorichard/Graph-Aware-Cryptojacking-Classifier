{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technical_accuracy": {
          "type": "integer",
          "description": "Integer from 1 through 5"
        },
        "coherence": {
          "type": "integer",
          "description": "Integer from 1 through 5"
        },
        "cybersecurity_relevance": {
          "type": "integer",
          "description": "Integer from 1 through 5"
        },
        "actionable_utility": {
          "type": "integer",
          "description": "Integer from 1 through 5"
        }
      },
      "required": [
        "technical_accuracy",
        "coherence",
        "cybersecurity_relevance",
        "actionable_utility"
      ]
    },
    "justifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technical_accuracy": {
          "type": "string"
        },
        "coherence": {
          "type": "string"
        },
        "cybersecurity_relevance": {
          "type": "string"
        },
        "actionable_utility": {
          "type": "string"
        }
      },
      "required": [
        "technical_accuracy",
        "coherence",
        "cybersecurity_relevance",
        "actionable_utility"
      ]
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quote": {
            "type": "string"
          },
          "candidate_path": {
            "type": "string"
          },
          "evidence_reference": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "invented_api",
              "invented_function",
              "other",
              "shap_misrepresentation",
              "unsupported_behavior",
              "unsupported_certainty",
              "unsupported_crypto"
            ]
          }
        },
        "required": [
          "quote",
          "candidate_path",
          "evidence_reference",
          "reason",
          "category"
        ]
      }
    },
    "shap_faithfulness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "faithful": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "discrepancies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quote": {
                "type": "string"
              },
              "candidate_path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "quote",
              "candidate_path",
              "reason"
            ]
          }
        }
      },
      "required": [
        "faithful",
        "reason",
        "discrepancies"
      ]
    },
    "evidence_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "scores",
    "justifications",
    "unsupported_claims",
    "shap_faithfulness",
    "evidence_limitations",
    "summary"
  ]
}
