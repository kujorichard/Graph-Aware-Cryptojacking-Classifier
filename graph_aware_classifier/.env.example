# ═══════════════════════════════════════════════════════════════════════════
# LLM Backend Configuration for Stage 5 — Evidence-Grounded Code Analysis
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit the values.
#   cp .env.example .env

# Backend: "ollama" for local inference, "claude" for Anthropic API
LLM_BACKEND=ollama

# ── Ollama (local) ────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen3:14b-q4_K_M
OLLAMA_HOST=http://localhost:11434

# ── Claude (API) ──────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=your-api-key-here

# ── Shared LLM settings ──────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
LLM_TIMEOUT=120.0

# ── G-Eval judge configuration (independent from explanation generation) ──
# Defaults to LLM_BACKEND/model settings; override these when selecting a
# different judge or when switching the explanation generator to Claude.
# GEVAL_BACKEND=ollama
# GEVAL_OLLAMA_MODEL=qwen3:14b-q4_K_M
# GEVAL_OLLAMA_HOST=http://localhost:11434
# GEVAL_CLAUDE_MODEL=claude-sonnet-4-20250514
# GEVAL_ANTHROPIC_API_KEY=your-api-key-here
# GEVAL_TEMPERATURE=0.0
# GEVAL_MAX_TOKENS=2048
