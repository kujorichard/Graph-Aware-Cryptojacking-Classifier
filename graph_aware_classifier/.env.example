# ═══════════════════════════════════════════════════════════════════════════
# LLM Backend Configuration for Stage 5 — Evidence-Grounded Code Analysis
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit the values.
#   cp .env.example .env

# Backend: "ollama" for local inference, "claude" for Anthropic API
LLM_BACKEND=ollama

# ── Ollama (local) ────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen3:14b-q4_K_M
OLLAMA_HOST=http://localhost:11434

# ── Claude (API) ──────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=your-api-key-here

# ── Shared LLM settings ──────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
LLM_TIMEOUT=120.0
